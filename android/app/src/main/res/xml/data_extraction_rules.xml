<?xml version="1.0" encoding="utf-8"?>
<!-- Applies on API 31+. Keeps the Gemini API key out of cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gemini_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gemini_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
