<resources>
    <!--
      Launcher3/Lawnchair failed to inflate the widget with:
      "Failed to create idmap because of no resources were overlaid" —
      its Material You re-theming pass throws instead of no-op'ing when a
      widget has zero dynamic-color-eligible resources. Giving it real
      system_* slots to remap (API 31+ only) satisfies that pass. Other
      widgets on the same device theme fine, which is what points at this
      rather than a device-wide bug.
    -->
    <color name="widget_background">@android:color/system_neutral1_800</color>
    <color name="widget_text">@android:color/system_neutral1_50</color>
</resources>
