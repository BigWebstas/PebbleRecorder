<?xml version="1.0" encoding="utf-8"?>
<!--
  The android XMLNS URI MUST be ".../apk/res/android". With the "/apk" missing,
  aapt2 still compiles the file but never binds android: attributes to their
  framework resource IDs, so at runtime layout_width/height resolve to nothing
  and AppWidgetHostView inflation dies with "You must supply a layout_width
  attribute" — surfaced by the launcher as "Can't load widget".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_background"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- The row fills the widget width and the status label takes what's left (ellipsized), so
         "Recording" + timer can never push the stop button off a narrow widget. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_dot_idle" />

        <TextView
            android:id="@+id/widget_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_status_idle"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <Chronometer
            android:id="@+id/widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Plain <View> isn't allowed in RemoteViews and breaks inflation ("Can't load widget"); ImageView is. -->
        <ImageView
            android:id="@+id/widget_record_divider"
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:background="#33FFFFFF"
            android:importantForAccessibility="no" />

        <ImageButton
            android:id="@+id/widget_record_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/record_button"
            android:padding="4dp"
            android:src="@drawable/widget_ic_record" />

    </LinearLayout>

    <TextView
        android:id="@+id/widget_subtext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.6"
        android:includeFontPadding="false"
        android:text="@string/widget_subtext"
        android:textColor="@color/widget_text"
        android:textSize="11sp" />

</LinearLayout>
