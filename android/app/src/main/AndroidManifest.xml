<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PebbleRecorder"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PebbleRecorder">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Bound by the Pebble/Core companion app whenever the PebbleRecorder watchapp
          (see watch/package.json for its UUID) is opened on a paired watch. Must stay
          registered under this exact action for PebbleKit Android 2 to find it.

          Also self-started (specialUse type) by MainActivity as soon as the app is opened, and
          kept running persistently as a low-priority "armed" foreground service from then on.
          Android forbids starting a *new* microphone-type foreground service while the app has
          no visible UI (see MainActivity's start call) - but adding the microphone type to an
          *already-foregrounded* service is allowed, so recording only works because this service
          is already in the foreground by the time a watch COMMAND arrives.
        -->
        <service
            android:name=".PebbleListenerService"
            android:exported="true"
            android:foregroundServiceType="specialUse|microphone">
            <intent-filter>
                <action android:name="io.rebble.pebblekit2.RECEIVE_DATA_FROM_WATCH" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="pebble_watch_trigger_listener" />
        </service>

    </application>

</manifest>
